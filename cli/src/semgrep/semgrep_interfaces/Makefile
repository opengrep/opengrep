# The interfaces shared by the OCaml binary and the Python wrapper.
#
# The OCaml code for the .atd files is generated by dune at build time.
# Run 'make' here after editing semgrep_output_v1.atd, to regenerate the
# Python binding, or generate.py, to regenerate the language files.
# The generated files are kept under version control.

.PHONY: build
build: semgrep_output_v1.py Language.ml Language.mli lang.json

# atdpy 2.16.0, the version of atdgen of the opam switch
semgrep_output_v1.py: semgrep_output_v1.atd
	atdpy $<

Language.ml Language.mli lang.json: generate.py
	python3 generate.py
