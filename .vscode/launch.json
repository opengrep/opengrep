{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Opengrep: Help",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/_build/install/default/bin/opengrep.bc",
      "arguments": ["--help"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "Opengrep Core: Help",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/_build/install/default/bin/opengrep.bc",
      "arguments": ["--core", "-help"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "Opengrep: LSP",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/_build/install/default/bin/opengrep.bc",
      "arguments": ["lsp"],
      "preLaunchTask": "Build Core Bytecode"
    },
    {
      "name": "Test: LS",
      "type": "ocaml.earlybird",
      "request": "launch",
      "program": "${workspaceFolder}/_build/default/src/tests/test.bc",
      "arguments": ["test", "Language Server"],
      "preLaunchTask": "Build Test Bytecode"
    }
  ]
}
