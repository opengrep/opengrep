# The interfaces of the opengrep binary: its JSON output, its rule schema
# and the list of supported languages.
#
# The OCaml code for the .atd files is generated by dune at build time.
# Run 'make' here after editing generate.py, to regenerate the language files.
# The generated files are kept under version control.

.PHONY: build
build: Language.ml Language.mli lang.json

Language.ml Language.mli lang.json: generate.py
	python3 generate.py
